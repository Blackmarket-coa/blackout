# Base URL for the API. Required in local dev (point it at the running API,
# e.g. http://localhost:3001). Leave UNSET in production: the canonical deploy
# serves the SPA and the API on the same origin, with nginx proxying /v1/* to
# the API (see infra/nginx/sites-available/theblackout.app.conf), so an empty
# value (same-origin) is correct there.
VITE_API_BASE_URL=http://localhost:3001
VITE_MATRIX_HOMESERVER_URL=http://localhost:8008
VITE_FEATURE_GOVERNANCE=true
VITE_FEATURE_FORUM=true
VITE_FEATURE_DEADDROP=true
VITE_FEATURE_MODERATION=true

# --- Monetization go-live ---
# Reveal the marketplace surface in the Monetization module. Off by default.
# The flag env key is BLACKOUT_MONETIZATION_MARKETPLACE (no VITE_ prefix); it
# must be exposed to the client build. Beta-unlock forces it true regardless.
# BLACKOUT_MONETIZATION_MARKETPLACE=true
#
# Config switch, default UNLOCKED: while beta-unlock is on, every premium
# feature/tier resolves as owned, so buy CTAs read "Included in your access"
# and nothing is charged. Set to false (both keys) to enable real gating +
# charging once Stripe + the FBM catalog are live.
# VITE_BLACKOUT_BETA_UNLOCK_ALL=false
# BLACKOUT_BETA_UNLOCK_ALL=false

# MapLibre style URL for the Coalition map (W5). Unset, the map falls back to
# the public OpenStreetMap raster tiles — which sends every user's tile
# traffic to openstreetmap.org while the deployment's own martin tile server
# (infra/single-server-baseline, served at /tiles/) sits idle. Point this at
# your deployed style (see docs/runbooks/SPATIAL_LAYER_BASE.md) to keep tile
# traffic on-house.
# VITE_MAPLIBRE_STYLE_URL=

# Black Mask chat panel session lengths (launch-plan B3). Off by default: with
# it unset the panel (/embed) signs in and keeps its session exactly as before
# B3. On (1, true, yes or on, read when the client is BUILT), panel sign-in asks
# how long the session lasts and the panel keeps its own session, separate from
# the full app's. Timed lengths are offered only when the homeserver module
# (session_lengths_enabled) and the API (BLACKOUT_SESSION_LENGTHS) both enforce
# them. See docs/black-mask-chat-panel-and-account-link.md section 3.
# VITE_BLACKOUT_PANEL_SESSION_LENGTHS=1

# Default access for a new canopy or den before the person touches the access
# chooser (apps/blackout-client/src/app/components/create-room/newRoomDefaults.ts).
# Unset or "public" (the default): in the Blackout app a new canopy, a den with
# no canopy and a den inside a public canopy are public and not end-to-end
# encrypted; a den inside a canopy that is not public is restricted to it and
# encrypted; a public canopy is listed in the Blackout canopy directory. The
# Black Mask chat panel (/embed) always defaults to private (and encrypted for
# dens). Set to "private" (read when the client is BUILT) to make the app use
# the panel's private defaults everywhere; any other value keeps the default.
# The panel's defaults never change. See TRUST.md section 1.
# VITE_BLACKOUT_NEW_ROOM_DEFAULT=private

# Account -> Subscriptions "Manage billing on Free Black Market" (flag
# BLACKOUT_ACCOUNT_SUBSCRIPTIONS, default off). The client opens the FBM
# manage link only when its origin is in this comma-separated list of https
# origins (plain http is accepted for localhost only) and its path is FBM's
# manage page. Unset = https://api.freeblackmarket.com only. Set it for a
# staging or local FBM.
# VITE_FBM_MANAGE_ORIGINS=https://api.freeblackmarket.com
