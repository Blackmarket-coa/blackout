# Required
SERVER_NAME=blackout.example.org
DATABASE_HOST=postgres.internal
DATABASE_PORT=5432
DATABASE_NAME=blackout
DATABASE_USER=blackout
DATABASE_PASSWORD=change-me
REDIS_HOST=redis.internal
REDIS_PORT=6379
REGISTRATION_SHARED_SECRET=change-me
TURN_URIS=turn:turn.example.org:3478?transport=udp
TURN_SHARED_SECRET=change-me

# Auth
ENABLE_REGISTRATION=true
# Synapse requires this to be true when ENABLE_REGISTRATION=true and no
# email/captcha/3PID/token verifier is configured. Otherwise startup aborts
# with a config error and /register responds with M_FORBIDDEN.
ENABLE_REGISTRATION_WITHOUT_VERIFICATION=true
# JWT login is off in homeserver.yaml.template, whatever is set here. JWT_SECRET
# is used only once `enabled: true` is written there; then set it to a long
# random value (an empty one stops startup).
JWT_SECRET=

# Deployment profile (managed | standalone | constrained)
BLACKOUT_PROFILE=managed

# Optional integrations
FBM_API_URL=
BLACKSTAR_URL=
OLLAMA_URL=
