PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost/blackout
REDIS_URL=redis://localhost:6379

# IMPORTANT: replace with a 32+ character high-entropy value (mixed character
# classes, no "changeme"/"secret"/"password" substrings). The new Hono API
# (packages/api) rejects weak values at startup.
JWT_SECRET=change-me

# CORS — required in production. Comma-separated list of origin URLs (no
# trailing slash). Use "*" only outside production.
# CORS_ALLOW_CREDENTIALS=true is incompatible with "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

NODE_ENV=development
