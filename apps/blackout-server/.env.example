PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blackout
REDIS_URL=redis://localhost:6379

# IMPORTANT: replace with a 32+ char high-entropy secret (mixed character classes,
# no "changeme"/"secret"/"password" substrings). Startup will reject weak values.
JWT_SECRET=replace-me-with-strong-secret-at-least-32-chars-mixed-AbC1!

# CORS — required in production. Comma-separated list of origin URLs (no trailing slash).
# Use "*" only outside production. CORS_ALLOW_CREDENTIALS=true is incompatible with "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

NODE_ENV=development
