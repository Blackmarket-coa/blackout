{
  "name": "@blackout/root",
  "version": "0.0.0",
  "private": true,
  "description": "Blackout monorepo \u2013 secure communication platform",
  "license": "SEE LICENSE IN README.md",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "web:dev": "pnpm --filter @blackout/client dev",
    "web:build": "pnpm --filter @blackout/client build",
    "client:build": "pnpm --filter @blackout/client build",
    "web:test": "pnpm --filter @blackout/client test:unit",
    "web:test:mobile": "pnpm --filter @blackout/blackout-web test:mobile",
    "desktop:dev": "pnpm --dir blackout-desktop dev",
    "desktop:build": "pnpm --dir blackout-desktop build",
    "mobile:dev": "pnpm --filter blackout-mobile dev",
    "mobile:build": "pnpm --filter blackout-mobile build",
    "mobile:sync:android": "pnpm --filter blackout-mobile sync:android",
    "mobile:sync:ios": "pnpm --filter blackout-mobile sync:ios",
    "mobile:open:ios": "pnpm --filter blackout-mobile open:ios",
    "mobile:open:android": "pnpm --filter blackout-mobile open:android",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean",
    "smoke:aligned": "node tools/ci/run-smoke-aligned-checks.mjs",
    "ci:parity": "node tools/ci/run-centralized-parity.mjs",
    "start": "node index.js",
    "guard:feature-registry": "node tools/ci/check-feature-registry.mjs",
    "test:guard:feature-registry": "node --test tools/ci/check-feature-registry.test.mjs",
    "ci:smoke:preset-matrix": "node tools/ci/run-preset-smoke-matrix.mjs",
    "guard:feature-budget": "node tools/ci/check-feature-ui-test-coverage.mjs",
    "test:guard:feature-budget": "node --test tools/ci/check-feature-ui-test-coverage.test.mjs",
    "guard:preset-complete": "node tools/ci/check-preset-complete-features.mjs",
    "test:guard:preset-complete": "node --test tools/ci/check-preset-complete-features.test.mjs",
    "guard:pr-dod": "node tools/ci/check-pr-dod.mjs",
    "test:guard:pr-dod": "node --test tools/ci/check-pr-dod.test.mjs",
    "guard:duplicate-paths": "node tools/ci/check-duplicate-paths.mjs",
    "guard:db-migrations": "node tools/ci/check-db-migrations.mjs",
    "guard:v1-route-coverage": "node tools/ci/check-v1-route-coverage.mjs",
    "ci:migrations:ephemeral": "node tools/ci/verify-migrations-ephemeral.mjs",
    "guard:api-freeze": "node tools/ci/enforce-api-freeze.mjs",
    "contracts:generate": "pnpm --filter @blackout/contracts generate",
    "contracts:check": "node tools/ci/check-contracts-generated.mjs",
    "guard:call-config": "node tools/ci/check-call-config.mjs",
    "guard:ops-artifacts": "node tools/ci/check-ops-artifacts.mjs",
    "guard:audit-clean": "pnpm audit --prod --audit-level moderate",
    "probe:calls:synthetic": "node tools/ci/synthetic-call-probe.mjs",
    "guard:auth-secrets": "node tools/ci/check-auth-secrets.mjs",
    "guard:cors-allowlist": "node tools/ci/check-cors-allowlist.mjs",
    "guard:runtime-targets": "node tools/ci/check-canonical-runtime-targets.mjs",
    "test:guard:runtime-targets": "node --test tools/ci/check-canonical-runtime-targets.test.mjs",
    "build:runtime": "pnpm --filter @blackout/contracts --filter @blackout/core --filter @blackout/server --filter @blackout/client --filter blackout-mobile run build",
    "lint:runtime": "pnpm --filter @blackout/contracts --filter @blackout/core --filter @blackout/server --filter @blackout/client --filter blackout-mobile run lint",
    "test:runtime": "pnpm --filter @blackout/contracts --filter @blackout/core --filter @blackout/server --filter @blackout/client --filter blackout-mobile run test:unit",
    "guard:runtime-scripts": "node tools/ci/check-runtime-scripts.mjs",
    "test:guard:runtime-scripts": "node --test tools/ci/check-runtime-scripts.test.mjs",
    "dev:client": "pnpm --filter @blackout/client dev",
    "dev:server": "pnpm --filter @blackout/server dev",
    "guard:dev-filters": "node tools/ci/check-dev-filter-resolution.mjs",
    "test:guard:dev-filters": "node --test tools/ci/check-dev-filter-resolution.test.mjs",
    "guard:workspace-packages": "node tools/ci/check-workspace-package-assertions.mjs",
    "guard:no-direct-fetch-in-client-features": "node tools/ci/check-no-direct-fetch-in-client-features.mjs",
    "guard:matrix-sdk-version-alignment": "node tools/ci/check-matrix-sdk-version-alignment.mjs",
    "guard:matrix-sdk-internal-imports": "node tools/ci/check-matrix-sdk-internal-imports.mjs",
    "guard:protocol-import-consistency": "node tools/ci/check-protocol-import-consistency.mjs",
    "guard:legacy-isolation": "node tools/ci/check-legacy-isolation.mjs",
    "qa:monorepo": "node tools/ci/run-qa-monorepo.mjs",
    "guard:legacy-runtime-imports": "node tools/ci/check-legacy-runtime-imports.mjs",
    "test:guard:legacy-runtime-imports": "node --test tools/ci/check-legacy-runtime-imports.test.mjs",
    "guard:deployment-readiness": "node tools/ci/check-deployment-readiness.mjs",
    "guard:frontend-consolidation": "node tools/ci/check-frontend-consolidation-gates.mjs",
    "ci:smoke:blackout-client": "node tools/ci/run-blackout-client-smoke-matrix.mjs",
    "guard:blackout-client-release-gate": "node tools/ci/check-blackout-client-release-gate.mjs",
    "test:guard:blackout-client-release-gate": "node --test tools/ci/check-blackout-client-release-gate.test.mjs",
    "release:generate-signoff": "node tools/ci/generate-staging-signoff.mjs",
    "test:release:generate-signoff": "node --test tools/ci/generate-staging-signoff.test.mjs",
    "mobile:workspace:build": "pnpm --filter @blackout/mobile build",
    "mobile:workspace:test": "pnpm --filter @blackout/mobile test",
    "guard:matrix-sdk-baseline": "pnpm guard:matrix-sdk-version-alignment",
    "e2e": "playwright test --project=chromium",
    "e2e:visual": "playwright test --project=visual-mobile-light --project=visual-mobile-dark --project=visual-tablet-light --project=visual-tablet-dark --project=visual-desktop-light --project=visual-desktop-dark",
    "e2e:visual:update": "playwright test --project=visual-mobile-light --project=visual-mobile-dark --project=visual-tablet-light --project=visual-tablet-dark --project=visual-desktop-light --project=visual-desktop-dark --update-snapshots",
    "e2e:visual:authed": "playwright test --project=visual-mobile-light --project=visual-mobile-dark --project=visual-tablet-light --project=visual-tablet-dark --project=visual-desktop-light --project=visual-desktop-dark",
    "e2e:install": "playwright install --with-deps chromium",
    "audit:navigation": "tsx tools/audit-navigation/crawl-web.ts && tsx tools/audit-navigation/audit-mobile.ts",
    "audit:navigation:web": "tsx tools/audit-navigation/crawl-web.ts",
    "audit:navigation:mobile": "tsx tools/audit-navigation/audit-mobile.ts",
    "test:e2e:navigation": "playwright test --config=playwright.navigation-audit.config.ts",
    "test:e2e:state-explosion": "playwright test --config=playwright.state-explosion.config.ts"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@electric-sql/pglite": "^0.3.9",
    "@playwright/test": "^1.58.2",
    "yaml": "^2.6.1"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@0.8.11": "0.8.13",
      "@xmldom/xmldom@0.8.12": "0.8.13",
      "brace-expansion@1.1.12": "1.1.13",
      "brace-expansion@5.0.4": "5.0.6",
      "brace-expansion@5.0.5": "5.0.6",
      "esbuild@0.19.12": "0.25.0",
      "esbuild@0.21.5": "0.25.0",
      "hono@4.12.18": "4.12.21",
      "i18next-http-backend@2.5.2": "3.0.5",
      "lodash@4.17.23": "4.18.0",
      "picomatch@4.0.3": "4.0.4",
      "postcss@8.5.8": "8.5.10",
      "sanitize-html@2.12.1": "2.17.4",
      "serialize-javascript@6.0.2": "7.0.5",
      "shell-quote@1.8.3": "1.8.4",
      "uuid@10.0.0": "14.0.0",
      "uuid@11.1.0": "14.0.0",
      "uuid@13.0.0": "14.0.0",
      "vite@5.4.21": "6.4.2",
      "ws@8.18.3": "8.20.1",
      "ws@8.19.0": "8.20.1",
      "@types/react": "^18.2.39",
      "@types/react-dom": "^18.2.17"
    }
  }
}
