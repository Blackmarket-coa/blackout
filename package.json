{
  "name": "@blackout/root",
  "version": "0.0.0",
  "private": true,
  "description": "Blackout monorepo – secure communication platform",
  "license": "SEE LICENSE IN README.md",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "smoke:aligned": "node tools/ci/run-smoke-aligned-checks.mjs",
    "ci:parity": "node tools/ci/run-centralized-parity.mjs",
    "guard:port": "node tools/ci/check-no-port-changes.mjs",
    "guard:port:range": "node tools/ci/check-no-port-changes.mjs",
    "test:guard:port": "node --test tools/ci/check-no-port-changes.test.mjs",
    "start": "node index.js",
    "guard:feature-registry": "node tools/ci/check-feature-registry.mjs",
    "test:guard:feature-registry": "node --test tools/ci/check-feature-registry.test.mjs",
    "ci:smoke:preset-matrix": "node tools/ci/run-preset-smoke-matrix.mjs",
    "guard:feature-budget": "node tools/ci/check-feature-ui-test-coverage.mjs",
    "test:guard:feature-budget": "node --test tools/ci/check-feature-ui-test-coverage.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "5.9.3"
  }
}
