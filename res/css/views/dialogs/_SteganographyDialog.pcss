.mx_SteganographyDialog {
    .mx_SteganographyDialog_modeToggle {
        display: flex;
        gap: var(--cpd-space-2x);
        margin-bottom: var(--cpd-space-4x);
    }

    .mx_SteganographyDialog_modeButton {
        flex: 1;
        padding: var(--cpd-space-2x) var(--cpd-space-4x);
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: 8px;
        background: transparent;
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-md-medium);
        cursor: pointer;
        transition:
            background-color 0.15s,
            color 0.15s,
            border-color 0.15s;

        &:hover {
            border-color: var(--cpd-color-border-interactive-hovered);
        }

        &.mx_SteganographyDialog_modeButton--active {
            background: var(--cpd-color-bg-action-primary-rest);
            color: var(--cpd-color-text-on-solid-primary);
            border-color: var(--cpd-color-bg-action-primary-rest);
        }
    }

    .mx_SteganographyDialog_description {
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
        margin-bottom: var(--cpd-space-4x);
    }

    .mx_SteganographyDialog_field {
        margin-bottom: var(--cpd-space-4x);

        label {
            display: block;
            font: var(--cpd-font-body-sm-medium);
            color: var(--cpd-color-text-primary);
            margin-bottom: var(--cpd-space-1x);
        }

        textarea,
        input[type="password"] {
            width: 100%;
            box-sizing: border-box;
            padding: var(--cpd-space-2x) var(--cpd-space-3x);
            border: 1px solid var(--cpd-color-border-interactive-secondary);
            border-radius: 8px;
            background: var(--cpd-color-bg-canvas-default);
            color: var(--cpd-color-text-primary);
            font: var(--cpd-font-body-md-regular);
            resize: vertical;

            &:focus {
                border-color: var(--cpd-color-border-interactive-hovered);
                outline: none;
            }

            &::placeholder {
                color: var(--cpd-color-text-secondary);
            }
        }
    }

    .mx_SteganographyDialog_sourcePreview {
        padding: var(--cpd-space-3x);
        background: var(--cpd-color-bg-subtle-secondary);
        border-radius: 8px;
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-secondary);
        word-break: break-word;
    }

    .mx_SteganographyDialog_hint {
        font: var(--cpd-font-body-sm-medium);
        color: var(--cpd-color-text-success-primary);
        margin-top: var(--cpd-space-2x);
    }

    .mx_SteganographyDialog_encryption {
        margin-bottom: var(--cpd-space-4x);
    }

    .mx_SteganographyDialog_checkboxLabel {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        font: var(--cpd-font-body-md-medium);
        color: var(--cpd-color-text-primary);
        cursor: pointer;
        margin-bottom: var(--cpd-space-3x);

        input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--cpd-color-bg-action-primary-rest);
        }
    }

    .mx_SteganographyDialog_error {
        color: var(--cpd-color-text-critical-primary);
        font: var(--cpd-font-body-sm-medium);
        margin-bottom: var(--cpd-space-4x);
    }

    .mx_SteganographyDialog_result {
        margin-top: var(--cpd-space-2x);
        padding: var(--cpd-space-4x);
        background: var(--cpd-color-bg-subtle-secondary);
        border-radius: 8px;

        label {
            display: block;
            font: var(--cpd-font-body-sm-medium);
            color: var(--cpd-color-text-primary);
            margin-bottom: var(--cpd-space-2x);
        }
    }

    .mx_SteganographyDialog_resultContent {
        padding: var(--cpd-space-3x);
        background: var(--cpd-color-bg-canvas-default);
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: 8px;
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-primary);
        word-break: break-word;
        max-height: 200px;
        overflow-y: auto;
    }

    .mx_SteganographyDialog_resultActions {
        display: flex;
        gap: var(--cpd-space-3x);
        margin-top: var(--cpd-space-3x);

        button {
            padding: var(--cpd-space-2x) var(--cpd-space-4x);
            border: 1px solid var(--cpd-color-border-interactive-secondary);
            border-radius: 8px;
            background: transparent;
            color: var(--cpd-color-text-primary);
            font: var(--cpd-font-body-sm-medium);
            cursor: pointer;

            &:hover {
                border-color: var(--cpd-color-border-interactive-hovered);
            }

            &.mx_Dialog_primary {
                background: var(--cpd-color-bg-action-primary-rest);
                color: var(--cpd-color-text-on-solid-primary);
                border-color: var(--cpd-color-bg-action-primary-rest);

                &:hover {
                    background: var(--cpd-color-bg-action-primary-hovered);
                }
            }
        }
    }
}
