    "apiEndpoints": [
      "POST /v1/governance/votes",
      "GET  /v1/governance/votes/{voteId}",
      "POST /v1/governance/votes/{voteId}/cast"
    ]
  },

  "federation": {
    "source": "packages/core/src/federation/index.ts",
    "linkTypes": ["zone", "alliance", "supply_chain"],
    "apiEndpoints": [
      "POST /v1/federation/links"
    ]
  },

  "apiEndpoints": {
    "source": "packages/contracts/openapi/v1.yaml",
    "canonical": "/v1",
    "legacy": "/api (deprecated, scheduled for removal — see API_ALIAS_REMOVAL_DATE)",
    "endpoints": [
      "POST /v1/auth/register",
      "POST /v1/auth/login",
      "GET  /v1/channels",
      "POST /v1/channels",
      "GET  /v1/messages/{channelId}",
      "POST /v1/messages/{channelId}",
      "POST /v1/governance/votes",
      "GET  /v1/governance/votes/{voteId}",
      "POST /v1/governance/votes/{voteId}/cast",
      "POST /v1/federation/links"
    ]
  },

  "messageTypes": {
    "standard": ["m.text", "m.image", "m.file", "m.video", "m.audio", "m.sticker"],
    "custom": [
      { "type": "app.blackout.proposal", "description": "Governance proposal message" },
      { "type": "m.room.proposal",       "description": "Room-scoped proposal event" }
    ]
  },

  "environmentVariables": {
    "source": "apps/blackout-web/src/config.ts",
    "variables": [
      { "name": "VITE_FEATURE_DEPLOYMENT_DEFAULTS",      "description": "Initial preset (starter|governance|sovereignty)" },
      { "name": "VITE_FEATURE_TENANT_POLICY",            "description": "Organizational policy overrides (JSON)" },
      { "name": "VITE_FEATURE_USER_OVERRIDES",           "description": "Per-user feature overrides (JSON)" },
      { "name": "VITE_SIMPLE_MODE_DEFAULT",              "description": "UI complexity level" },
      { "name": "VITE_SHOW_ADVANCED_ADMIN_MODULES",      "description": "Toggle admin feature visibility" },
      { "name": "VITE_ONBOARDING_PROGRESSIVE_DISCLOSURE","description": "Gradual feature reveal during onboarding" },
      { "name": "VITE_ENGAGEMENT_POLICY_SERVER",         "description": "Server-side engagement configuration" },
      { "name": "VITE_ENGAGEMENT_POLICY_USER",           "description": "User engagement configuration" },
      { "name": "VITE_NOTIFICATION_RULES",               "description": "Notification rule overrides" },
      { "name": "VITE_RELEASE_COHORT",                   "description": "Rollout cohort: internal|beta|general" }
    ]
  }
