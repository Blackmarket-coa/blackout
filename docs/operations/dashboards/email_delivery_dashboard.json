{
  "title": "Email — Transactional Delivery",
  "version": 1,
  "panels": [
    { "id": "send_attempt_rate", "metric": "sum by (provider, kind) (rate(mail_send_attempts_total[5m]))" },
    { "id": "send_failure_rate", "metric": "sum by (provider, kind, reason) (rate(mail_send_failures_total[5m]))" },
    { "id": "send_failure_ratio", "metric": "sum(rate(mail_send_failures_total[5m])) / clamp_min(sum(rate(mail_send_attempts_total[5m])), 0.001)" },
    { "id": "send_duration_p95", "metric": "histogram_quantile(0.95, sum by (le, provider) (rate(mail_send_duration_seconds_bucket[5m])))" },
    { "id": "send_outcome_breakdown", "metric": "sum by (outcome) (rate(mail_send_duration_seconds_count[5m]))" },
    { "id": "verification_tokens_issued_rate", "metric": "sum by (outcome) (rate(email_verification_tokens_issued_total[5m]))" },
    { "id": "verification_tokens_consumed_rate", "metric": "sum by (outcome) (rate(email_verification_tokens_consumed_total[5m]))" },
    { "id": "verification_redemption_failure_ratio", "metric": "sum(rate(email_verification_tokens_consumed_total{outcome=~\"invalid|expired|revoked|email_changed\"}[15m])) / clamp_min(sum(rate(email_verification_tokens_consumed_total[15m])), 0.001)" }
  ]
}
