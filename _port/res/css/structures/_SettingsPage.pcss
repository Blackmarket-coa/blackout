.mx_SettingsPage {
    display: flex;
    width: 100%;
    height: 100%;
    background-color: $background;
    position: absolute;
    inset: 0;
    z-index: 100;
}

.mx_SettingsPage_sidebar {
    width: 240px;
    min-width: 200px;
    flex-shrink: 0;
    background-color: var(--cpd-color-bg-subtle-primary);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: var(--cpd-space-4x) 0;
    border-right: 1px solid var(--cpd-color-border-interactive-primary);
}

.mx_SettingsPage_section {
    padding: var(--cpd-space-2x) 0;

    & + & {
        border-top: 1px solid var(--cpd-color-border-interactive-primary);
        margin-top: var(--cpd-space-2x);
        padding-top: var(--cpd-space-4x);
    }
}

.mx_SettingsPage_sectionHeader {
    color: $secondary-content;
    font: var(--cpd-font-body-xs-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0 var(--cpd-space-4x) var(--cpd-space-2x);
    margin: 0;
}

.mx_SettingsPage_navItem {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    cursor: pointer;
    border-radius: 8px;
    margin: 1px var(--cpd-space-2x);
    color: $primary-content;
    font: var(--cpd-font-body-md-medium);
    background: transparent;
    border: none;
    width: calc(100% - 2 * var(--cpd-space-2x));
    text-align: start;
    transition:
        background-color var(--transition-short),
        color var(--transition-short);

    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }

    &.mx_SettingsPage_navItem--active {
        background-color: var(--cpd-color-bg-action-primary-rest);
        color: var(--cpd-color-text-on-solid-primary);

        .mx_SettingsPage_navItemIcon svg {
            color: var(--cpd-color-text-on-solid-primary);
        }
    }
}

.mx_SettingsPage_navItemIcon {
    display: flex;
    align-items: center;
    flex-shrink: 0;

    svg {
        width: 20px;
        height: 20px;
        color: $secondary-content;
    }
}

.mx_SettingsPage_navItemLabel {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_SettingsPage_navItemAlert {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--cpd-color-icon-critical-primary);
    flex-shrink: 0;
}

.mx_SettingsPage_content {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
}

.mx_SettingsPage_scrollable {
    height: 100%;
    overflow-y: auto;
}

.mx_SettingsPage_contentInner {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--cpd-space-10x) var(--cpd-space-8x);
    width: 100%;
    box-sizing: border-box;
}

.mx_SettingsPage_closeButton {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    margin: auto var(--cpd-space-2x) var(--cpd-space-4x);
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    color: $secondary-content;
    cursor: pointer;
    border-radius: 8px;
    font: var(--cpd-font-body-md-regular);
    border: none;
    background: transparent;
    width: calc(100% - 2 * var(--cpd-space-2x));
    text-align: start;
    transition:
        background-color var(--transition-short),
        color var(--transition-short);

    svg {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary);
        color: $primary-content;
    }
}

.mx_SettingsPage_toastContainer {
    position: absolute;
    bottom: var(--cpd-space-6x);
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
}

/* Responsive: hide sidebar labels on narrow screens */
@media (max-width: 900px) {
    .mx_SettingsPage_sidebar {
        width: 64px;
        min-width: 64px;
    }

    .mx_SettingsPage_sectionHeader,
    .mx_SettingsPage_navItemLabel,
    .mx_SettingsPage_closeButton span {
        display: none;
    }

    .mx_SettingsPage_navItem {
        justify-content: center;
        padding: var(--cpd-space-3x);
        gap: 0;
    }

    .mx_SettingsPage_closeButton {
        justify-content: center;
        padding: var(--cpd-space-3x);
        gap: 0;
    }

    .mx_SettingsPage_contentInner {
        padding: var(--cpd-space-6x) var(--cpd-space-4x);
    }
}
