# Alternative homeservers (mutually exclusive with synapse).
# Enable EITHER conduwuit OR dendrite, not both at the same time:
#   docker compose --profile alt-homeserver-conduwuit up -d conduwuit
#   docker compose --profile alt-homeserver-dendrite up -d dendrite-db dendrite
# When using one of these, stop the synapse service.
CONDUWUIT_REGISTRATION_TOKEN=change-me-conduwuit-registration-token
DENDRITE_POSTGRES_DB=dendrite
DENDRITE_POSTGRES_USER=dendrite
DENDRITE_POSTGRES_PASSWORD=change-me-dendrite-postgres
DENDRITE_METRICS_PASSWORD=change-me-dendrite-metrics
