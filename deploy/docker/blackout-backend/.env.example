# Domain configuration
SERVER_NAME=theblackout.app
MATRIX_SERVER_NAME=matrix.theblackout.app
MATRIX_HOMESERVER_URL=https://matrix.theblackout.app
MATRIX_WELL_KNOWN_CLIENT_URL=https://matrix.theblackout.app

# PostgreSQL
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_HOST=redis
REDIS_PORT=6379

# Synapse
SYNAPSE_REPORT_STATS=no
SYNAPSE_ENABLE_REGISTRATION=true
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me-registration-secret
SYNAPSE_MACAROON_SECRET_KEY=change-me-macaroon-secret
SYNAPSE_FORM_SECRET=change-me-form-secret
SYNAPSE_AUTH_MODE=local
SYNAPSE_PASSWORD_AUTH_ENABLED=true
SYNAPSE_MSC3861_ENABLED=false
SYNAPSE_MSC3861_ISSUER=https://matrix.theblackout.app/
SYNAPSE_MSC3861_CLIENT_ID=0000000000000000000SYNAPSE
SYNAPSE_MSC3861_CLIENT_SECRET=change-me-synapse-mas-client-secret
SYNAPSE_MSC3861_CLIENT_AUTH_METHOD=client_secret_basic
SYNAPSE_MSC3861_ADMIN_TOKEN=change-me-synapse-mas-admin-token
SYNAPSE_MSC3861_ACCOUNT_MANAGEMENT_URL=https://matrix.theblackout.app/account

# Matrix Authentication Service (MAS)
MAS_DATABASE_URL=postgresql://synapse:change-me-postgres@postgres:5432/synapse
MAS_PUBLIC_BASE_URL=https://matrix.theblackout.app/
MAS_ISSUER=https://matrix.theblackout.app/
MAS_MATRIX_SECRET=change-me-mas-matrix-secret
MAS_CLIENT_ID=0000000000000000000SYNAPSE
MAS_CLIENT_SECRET=change-me-synapse-mas-client-secret
MAS_CLIENT_AUTH_METHOD=client_secret_basic
MAS_UPSTREAM_OIDC_ISSUER=https://idp.example.com/
MAS_UPSTREAM_OIDC_CLIENT_ID=change-me-upstream-oidc-client-id
MAS_UPSTREAM_OIDC_CLIENT_SECRET=change-me-upstream-oidc-client-secret
MAS_UPSTREAM_OIDC_CALLBACK_URL=https://matrix.theblackout.app/upstream/callback
MAS_SIGNING_KEY_ID=a-signing-key
MAS_SIGNING_KEY=change-me-ed25519-private-key
MAS_ENCRYPTION_KEY=change-me-64-hex-chars

# LiveKit networking
LIVEKIT_WS_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_RTC_UDP_START=50100
LIVEKIT_RTC_UDP_END=50200

# LiveKit and JWT
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret
LK_JWT_SIGNING_KEY=change-me-lk-jwt-signing-key
LK_JWT_TRUSTED_HOSTS=theblackout.app

# Draupnir
DRAUPNIR_ACCESS_TOKEN=change-me-draupnir-token
DRAUPNIR_MANAGEMENT_ROOM=!replace-with-management-room-id:theblackout.app
DRAUPNIR_PANTALAIMON_USE=false

# TLS / certbot
CERTBOT_EMAIL=foodcoa@gmail.com

# Sygnal push gateway
SYGNAL_HOSTNAME=sygnal
SYGNAL_HTTP_PORT=5000
SYGNAL_URL=http://sygnal:5000
SYGNAL_PUBLIC_URL=https://matrix.theblackout.app/_matrix/push/v1/notify

# Sygnal Apple Push Notification service (APNs)
SYGNAL_APNS_ENABLED=false
SYGNAL_APNS_APP_ID=com.example.blackout.ios
SYGNAL_APNS_TEAM_ID=change-me-team-id
SYGNAL_APNS_KEY_ID=change-me-key-id
SYGNAL_APNS_TOPIC=com.example.blackout.ios
SYGNAL_APNS_PUSH_TYPE=alert
SYGNAL_APNS_CONVERT_DEVICE_TOKEN_TO_HEX=true
SYGNAL_APNS_KEY_DIR=./sygnal
SYGNAL_APNS_KEYFILE=/etc/sygnal/keys/AuthKey.p8

# Sygnal Firebase Cloud Messaging (FCM)
SYGNAL_FCM_ENABLED=false
SYGNAL_FCM_APP_ID=com.example.blackout.android
SYGNAL_FCM_PROJECT_ID=change-me-fcm-project-id
SYGNAL_FCM_API_KEY=change-me-fcm-server-key

# Integrations profile (Matrix Hookshot)
HOOKSHOT_DOMAIN=matrix.theblackout.app
HOOKSHOT_URL=https://matrix.theblackout.app
HOOKSHOT_PORT=9993
HOOKSHOT_AS_TOKEN=change-me-hookshot-as-token
HOOKSHOT_HS_TOKEN=change-me-hookshot-hs-token
HOOKSHOT_FEED_POLL_INTERVAL_SECONDS=600
HOOKSHOT_POSTGRES_DB=hookshot
HOOKSHOT_POSTGRES_USER=hookshot
HOOKSHOT_POSTGRES_PASSWORD=change-me-hookshot-postgres

# Integrations profile (Mautrix Discord)
MAUTRIX_DISCORD_APPSERVICE_ID=mautrix-discord
MAUTRIX_DISCORD_APP_SERVICE_ADDRESS=http://mautrix-discord:29334
MAUTRIX_DISCORD_AS_TOKEN=change-me-mautrix-discord-as-token
MAUTRIX_DISCORD_HS_TOKEN=change-me-mautrix-discord-hs-token
MAUTRIX_DISCORD_BOT_USERNAME=discordbot
MAUTRIX_DISCORD_COMMAND_PREFIX=!discord
MAUTRIX_DISCORD_PUBLIC_ADDRESS=https://matrix.theblackout.app
MAUTRIX_DISCORD_DISCORD_TOKEN=change-me-discord-bot-token
MAUTRIX_DISCORD_PROVISIONING_SHARED_SECRET=change-me-mautrix-discord-provisioning-secret
MAUTRIX_DISCORD_POSTGRES_DB=mautrix_discord
MAUTRIX_DISCORD_POSTGRES_USER=mautrix_discord
MAUTRIX_DISCORD_POSTGRES_PASSWORD=change-me-mautrix-discord-postgres
MAUTRIX_DISCORD_METRICS_PORT=9104
