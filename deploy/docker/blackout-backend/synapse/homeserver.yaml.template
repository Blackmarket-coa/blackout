server_name: "${MATRIX_SERVER_NAME}"
pid_file: /data/homeserver.pid

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    resources:
      - names: [client, federation]
        compress: false

trusted_key_servers:
  - server_name: "matrix.org"

# Authentication mode toggles:
# - Local Synapse auth:     SYNAPSE_AUTH_MODE=local, SYNAPSE_MSC3861_ENABLED=false
# - MAS delegated auth:     SYNAPSE_AUTH_MODE=mas,   SYNAPSE_MSC3861_ENABLED=true
#
# Synapse v1.136.0 made the Matrix Authentication Service integration stable
# and v1.157.0 removed `experimental_features.msc3861`: a config that still
# carries that block does not start, even with `enabled: false`. The stable
# integration authenticates both directions with the secret MAS holds as
# `matrix.secret` (MAS_MATRIX_SECRET); the client id/secret, admin token and
# account management URL of the old block are no longer read. Needs MAS 0.20+.
matrix_authentication_service:
  enabled: ${SYNAPSE_MSC3861_ENABLED}
  endpoint: "http://mas:8080"
  secret: "${MAS_MATRIX_SECRET}"

# Appservice registrations (optional integrations profile):
# 1) Start the integrations profile once to render Hookshot registration:
#    docker compose --profile integrations up -d hookshot-db matrix-hookshot
# 2) Ensure integrations/hookshot/registration.yml exists on the host.
# 3) Keep this path enabled when Synapse should load the bridge appservice.
app_service_config_files:
  - /integrations/hookshot/registration.yml
  - /integrations/mautrix-discord/registration.yaml
  - /integrations/mautrix-telegram/registration.yaml
  - /integrations/mautrix-signal/registration.yaml
  - /integrations/mautrix-whatsapp/registration.yaml
  - /integrations/mautrix-slack/registration.yaml
  - /integrations/mautrix-googlechat/registration.yaml
  - /integrations/matrix-appservice-irc/registration.yaml

registration_shared_secret: "${SYNAPSE_REGISTRATION_SHARED_SECRET}"
macaroon_secret_key: "${SYNAPSE_MACAROON_SECRET_KEY}"
form_secret: "${SYNAPSE_FORM_SECRET}"

report_stats: ${SYNAPSE_REPORT_STATS}
public_baseurl: "https://${SERVER_NAME}/"

redis:
  enabled: true
  host: "${REDIS_HOST}"
  port: ${REDIS_PORT}
  password: "${REDIS_PASSWORD}"

database:
  name: psycopg2
  args:
    user: "${POSTGRES_USER}"
    password: "${POSTGRES_PASSWORD}"
    database: "${POSTGRES_DB}"
    host: "${POSTGRES_HOST}"
    port: ${POSTGRES_PORT}
    cp_min: 5
    cp_max: 10

media_store_path: /data/media_store
signing_key_path: /data/${MATRIX_SERVER_NAME}.signing.key

enable_registration: ${SYNAPSE_ENABLE_REGISTRATION}
# Without an email/captcha verifier configured, leaving verification required
# causes Synapse to reject /register with M_FORBIDDEN ("Registration has been
# disabled"). Default to allowing unverified signup; flip the env to false
# once an email/SMS or reCAPTCHA verifier is wired up.
#
# NOTE: envsubst (gettext-base) does NOT support ${VAR:-default} syntax — it
# leaves those expressions as literal text. Use plain ${VAR} and provide the
# default in .env.example so the rendered yaml always carries a real boolean.
enable_registration_without_verification: ${SYNAPSE_ENABLE_REGISTRATION_WITHOUT_VERIFICATION}
# Invite-only signup gate; tokens minted via the Synapse Admin API.
registration_requires_token: ${SYNAPSE_REGISTRATION_REQUIRES_TOKEN}
# Room defaults: turn E2EE on for every locally-created private room.
# "invite" covers the private_chat and trusted_private_chat presets (DMs and
# invite-only rooms). Public rooms are excluded on purpose — encrypting them
# breaks server-side search and hides history from later joiners while adding no
# confidentiality for content anyone can read. Backstop only: the clients and API
# set m.room.encryption in initial_state, enforced by `pnpm guard:room-encryption`.
# Unset means upstream default `off`. See docs/audits/2026-08-10-encryption-audit.md.
encryption_enabled_by_default_for_room_type: invite

password_config:
  enabled: ${SYNAPSE_PASSWORD_AUTH_ENABLED}

log_config: /data/${MATRIX_SERVER_NAME}.log.config

max_upload_size: 100M
url_preview_enabled: false

federation_metrics_domains:
  - "${MATRIX_SERVER_NAME}"


push:
  enabled: true
  include_content: true
  group_unread_count_by_room: true
  # Default destination for pushers that do not provide an explicit URL.
  push_gateway_url: "${SYGNAL_URL}"
