# matrix-appservice-irc appservice registration template (rendered by envsubst).
# This file is normally generated by `--generate-registration` against the
# bridge config; we ship a pre-rendered template so Synapse can load it on
# first boot under the `integrations` profile.

id: "${IRC_BRIDGE_APPSERVICE_ID}"
url: "${IRC_BRIDGE_APP_SERVICE_ADDRESS}"
as_token: "${IRC_BRIDGE_AS_TOKEN}"
hs_token: "${IRC_BRIDGE_HS_TOKEN}"
sender_localpart: "${IRC_BRIDGE_SENDER_LOCALPART}"
rate_limited: false
namespaces:
  users:
    - exclusive: true
      regex: '@irc_.*:${MATRIX_SERVER_NAME}'
  aliases:
    - exclusive: true
      regex: '#irc_.*:${MATRIX_SERVER_NAME}'
  rooms: []
protocols:
  - irc
