# Mautrix Telegram configuration template (rendered by envsubst).
# Reference: https://github.com/mautrix/telegram

homeserver:
  address: "http://synapse:8008"
  domain: "${MATRIX_SERVER_NAME}"
  verify_ssl: true

appservice:
  address: "${MAUTRIX_TELEGRAM_APP_SERVICE_ADDRESS}"
  hostname: 0.0.0.0
  port: 29317
  database: "postgres://${MAUTRIX_TELEGRAM_POSTGRES_USER}:${MAUTRIX_TELEGRAM_POSTGRES_PASSWORD}@${MAUTRIX_TELEGRAM_POSTGRES_HOST}:${MAUTRIX_TELEGRAM_POSTGRES_PORT}/${MAUTRIX_TELEGRAM_POSTGRES_DB}?sslmode=disable"
  database_opts:
    min_size: 1
    max_size: 10
  id: "${MAUTRIX_TELEGRAM_APPSERVICE_ID}"
  bot_username: "${MAUTRIX_TELEGRAM_BOT_USERNAME}"
  bot_displayname: Telegram Bridge Bot
  as_token: "${MAUTRIX_TELEGRAM_AS_TOKEN}"
  hs_token: "${MAUTRIX_TELEGRAM_HS_TOKEN}"

bridge:
  username_template: "telegram_{userid}"
  alias_template: "telegram_{groupname}"
  displayname_template: "{displayname} (Telegram)"
  command_prefix: "${MAUTRIX_TELEGRAM_COMMAND_PREFIX}"
  permissions:
    "*": relaybot
    "${MATRIX_SERVER_NAME}": full
  provisioning:
    enabled: true
    prefix: /_matrix/provision/v1
    shared_secret: "${MAUTRIX_TELEGRAM_PROVISIONING_SHARED_SECRET}"
  public_portals: false

metrics:
  enabled: true
  listen_port: ${MAUTRIX_TELEGRAM_METRICS_PORT}

telegram:
  api_id: ${MAUTRIX_TELEGRAM_API_ID}
  api_hash: "${MAUTRIX_TELEGRAM_API_HASH}"
  bot_token: "${MAUTRIX_TELEGRAM_BOT_TOKEN}"

logging:
  version: 1
  formatters:
    precise:
      format: "[%(asctime)s] [%(levelname)s@%(name)s] %(message)s"
  handlers:
    console:
      class: logging.StreamHandler
      formatter: precise
  root:
    level: INFO
    handlers: [console]
