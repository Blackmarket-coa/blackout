# Maubot configuration template (rendered by envsubst).
# Reference: https://github.com/maubot/maubot

database: postgres://${MAUBOT_POSTGRES_USER}:${MAUBOT_POSTGRES_PASSWORD}@${MAUBOT_POSTGRES_HOST}:${MAUBOT_POSTGRES_PORT}/${MAUBOT_POSTGRES_DB}?sslmode=disable
crypto_database: default

database_opts:
  min_size: 1
  max_size: 10

plugin_directories:
  upload: /data/plugins
  load:
    - /data/plugins
  trash: /data/trash
  db: /data/dbs

server:
  hostname: 0.0.0.0
  port: 29316
  public_url: ${MAUBOT_PUBLIC_URL}
  unshared_secret: ${MAUBOT_UNSHARED_SECRET}

homeservers:
  ${MATRIX_SERVER_NAME}:
    url: http://synapse:8008
    secret: ${MAUBOT_REGISTRATION_SECRET}
    public_url: ${MATRIX_HOMESERVER_URL}

admins:
  root: ${MAUBOT_ADMIN_PASSWORD_HASH}

api_features:
  login: true
  plugin: true
  plugin_upload: true
  instance: true
  instance_database: true
  client: true
  client_proxy: true
  client_auth: true
  dev_open: true
  log: true

logging:
  version: 1
  formatters:
    colored:
      (): maubot.lib.color_log.ColorFormatter
      format: "[%(asctime)s] [%(levelname)s@%(name)s] %(message)s"
  handlers:
    console:
      class: logging.StreamHandler
      formatter: colored
  loggers:
    maubot:
      level: INFO
    mautrix:
      level: INFO
    aiohttp:
      level: INFO
  root:
    level: INFO
    handlers: [console]
