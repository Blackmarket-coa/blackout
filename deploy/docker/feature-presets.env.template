# Blackout feature preset runtime defaults for enterprise/self-hosted deployments.
# Copy into your environment manager and adjust JSON values as needed.

# Rollout cohort for staged release control (internal|beta|general).
VITE_RELEASE_COHORT=internal

# Deployment defaults: choose preset + optional baseline feature overrides.
VITE_FEATURE_DEPLOYMENT_DEFAULTS={"preset":"tier_enterprise","defaults":{"features.matrix.widgetCompat":true}}

# Tenant/org policy: optional per-tenant preset and policy-level overrides.
VITE_FEATURE_TENANT_POLICY={"preset":"tier_enterprise","overrides":{},"allowUserOverrides":true,"userOverrideAllowlist":["features.composer.typingIndicators","features.widgets.layouts","features.bmc.streamerMode"]}

# User overrides: applied only when tenant policy allows them.
VITE_FEATURE_USER_OVERRIDES={"overrides":{"features.composer.typingIndicators":false}}

# TEMPORARY BETA OVERRIDE: unlock every service for every user, bypassing
# subscription/preset gating (payment-gating strategy is revised separately).
# Set both for a beta build; unset both to restore normal gating.
#   - Server (Node/API): BLACKOUT_BETA_UNLOCK_ALL
#   - Client (Vite build): VITE_BLACKOUT_BETA_UNLOCK_ALL
BLACKOUT_BETA_UNLOCK_ALL=true
VITE_BLACKOUT_BETA_UNLOCK_ALL=true
