#!/bin/sh
# Start the dedicated background-worker process (no HTTP server). Owns the
# periodic job loops so the app/canary replicas don't double-process them.
#
# The worker drains on SIGTERM (packages/api/src/backgroundWorker.ts), so it
# must be the process that receives it. `pnpm --filter @blackout/api worker`
# runs the script through `sh -c`; where that shell does not exec the command
# (dash, for one), the SIGTERM pnpm forwards stops at the shell, pnpm exits,
# and the worker is killed with the container without draining. Exec node
# itself instead, with tsx as its loader: it replaces this shell.
set -eu
. "$(dirname "$0")/_entrypoint-env.sh"
cd packages/api
exec node --import tsx src/worker.ts
