# Example Prometheus scrape config for the Blackout production Compose stack.
#
# Copy to deploy/docker/production/monitoring/prometheus/prometheus.yml and
# adjust the bearer-token file to point at your local secret.
#
# The blackout-api scrape target requires INTERNAL_METRICS_TOKEN to be set on
# the api service. Prometheus authenticates via Authorization: Bearer <token>.

global:
  scrape_interval: 30s
  scrape_timeout: 10s
  external_labels:
    cluster: blackout-prod

rule_files:
  - /etc/prometheus/bridge-alert-rules.yml

scrape_configs:
  - job_name: blackout-api
    scheme: http
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /run/secrets/internal_metrics_token
    static_configs:
      - targets:
          - app:3000
        labels:
          service: blackout-api
          tier: api

  - job_name: synapse
    # Scrape Synapse's /_synapse/metrics endpoint per the homeserver.yaml
    # listener defined in
    # infra/single-server-baseline/synapse/homeserver.yaml.template.
    # The dashboard at docs/operations/dashboards/synapse_capacity_dashboard.json
    # consumes these metrics. Authentication is by network reachability
    # (the metrics listener binds inside the data/app docker networks only).
    scheme: http
    metrics_path: /_synapse/metrics
    static_configs:
      - targets:
          - synapse:9101
        labels:
          service: synapse
          tier: matrix

  - job_name: postgres
    # Scrape postgres-exporter for autovacuum lag, connection pool, and
    # buffer-cache hit-ratio panels in
    # docs/operations/dashboards/synapse_capacity_dashboard.json.
    # Co-deployed with the single-server-baseline stack, see
    # infra/single-server-baseline/docker-compose.yml.
    scheme: http
    metrics_path: /metrics
    static_configs:
      - targets:
          - postgres-exporter:9187
        labels:
          service: postgres-exporter
          tier: data

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
