server {
    listen       ${ELEMENT_WEB_PORT};
    listen  [::]:${ELEMENT_WEB_PORT};
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    # Baseline hardening headers.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;

    # Set no-cache for the version, config and index.html
    # so that browsers always check for a new copy of Element Web.
    # NB http://your-domain/ and http://your-domain/? are also covered by this

    location = / {
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /version {
        add_header Cache-Control "no-cache";
    }
    location /i18n {
        add_header Cache-Control "no-cache";
    }
    location /home {
        add_header Cache-Control "no-cache";
    }
    location /sites {
        add_header Cache-Control "no-cache";
    }
    # covers config.json and config.hostname.json requests as it is prefix.
    location /config {
        root /tmp/element-web-config;
        add_header Cache-Control "no-cache";
    }
    location /modules {
        alias /modules;
    }

    # SPA fallback so deep links like /home/ are served by index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
    # Health endpoints for Kubernetes/container probes.

    location = /health/live {
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 200 '{"status":"live"}';
    }

    location = /health/ready {
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 200 '{"status":"ready"}';
    }

    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /50x.html;
}
