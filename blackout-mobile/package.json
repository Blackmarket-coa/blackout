{
  "name": "blackout-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Blackout mobile app - Capacitor wrapper around blackout-web",
  "scripts": {
    "build": "pnpm build:web",
    "build:web": "cd .. && pnpm --filter @blackout/blackout-web build:web",
    "copy": "pnpm build:web && cap copy",
    "sync": "pnpm build:web && cap sync",
    "dev": "pnpm build:web && cap sync && echo 'Run: cap open ios  OR  cap open android'",
    "dev:live": "cap run",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "setup": "./scripts/setup-mobile.sh",
    "build:ios": "cap sync ios && cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release archive",
    "build:android": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.1"
  }
}
