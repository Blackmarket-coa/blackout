{
  "_comment": "Template for Firebase Cloud Messaging (Android push). Download the real google-services.json from the Firebase console for the co.bmc.blackout app and place it next to this file as android/app/google-services.json (gitignored). Without it, FCM push will not work but the build still succeeds.",
  "project_info": {
    "project_number": "REPLACE_WITH_FIREBASE_PROJECT_NUMBER",
    "project_id": "REPLACE_WITH_FIREBASE_PROJECT_ID",
    "storage_bucket": "REPLACE_WITH_FIREBASE_PROJECT_ID.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "REPLACE_WITH_FIREBASE_ANDROID_APP_ID",
        "android_client_info": {
          "package_name": "co.bmc.blackout"
        }
      },
      "oauth_client": [],
      "api_key": [
        { "current_key": "REPLACE_WITH_FIREBASE_API_KEY" }
      ],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": []
        }
      }
    }
  ],
  "configuration_version": "1"
}
