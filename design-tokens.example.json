{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "blackout-design-tokens",
    "version": "1.0.0",
    "themes": {
      "default": "dark",
      "available": ["dark"]
    },
    "namingConvention": {
      "pattern": "{category}.{role}.{variant}.{state}",
      "rules": [
        "Use lowercase kebab-case for each segment (e.g., text-primary).",
        "Keep categories stable: color, typography, space, radius, border, shadow, motion.",
        "Use semantic roles over raw hue names at component boundaries.",
        "Reserve raw/palette tokens for internal composition only."
      ],
      "examples": [
        "color.bg.canvas",
        "color.fg.muted",
        "color.border.subtle.hover",
        "typography.size.300",
        "space.013"
      ]
    }
  },
  "tokens": {
    "theme": {
      "dark": {
        "color": {
          "palette": {
            "slate-950": { "$type": "color", "$value": "#020617" },
            "slate-900": { "$type": "color", "$value": "#0f172a" },
            "slate-800": { "$type": "color", "$value": "#1e293b" },
            "slate-200": { "$type": "color", "$value": "#e2e8f0" },
            "blue-400": { "$type": "color", "$value": "#60a5fa" },
            "green-400": { "$type": "color", "$value": "#4ade80" },
            "amber-400": { "$type": "color", "$value": "#fbbf24" },
            "red-400": { "$type": "color", "$value": "#f87171" }
          },
          "semantic": {
            "bg": {
              "canvas": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.slate-950}" },
              "surface": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.slate-900}" },
              "elevated": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.slate-800}" }
            },
            "fg": {
              "primary": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.slate-200}" },
              "muted": { "$type": "color", "$value": "#94a3b8" },
              "inverse": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.slate-950}" }
            },
            "border": {
              "subtle": { "$type": "color", "$value": "#334155" },
              "strong": { "$type": "color", "$value": "#475569" }
            },
            "state": {
              "info": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.blue-400}" },
              "success": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.green-400}" },
              "warning": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.amber-400}" },
              "danger": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.red-400}" }
            },
            "interactive": {
              "primary": {
                "default": { "$type": "color", "$value": "{tokens.theme.dark.color.palette.blue-400}" },
                "hover": { "$type": "color", "$value": "#3b82f6" },
                "pressed": { "$type": "color", "$value": "#2563eb" },
                "disabled": { "$type": "color", "$value": "#334155" }
              }
            }
          }
        }
      }
    },
    "typography": {
      "fontFamily": {
        "sans": { "$type": "fontFamily", "$value": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif" },
        "mono": { "$type": "fontFamily", "$value": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, monospace" }
      },
      "size": {
        "100": { "$type": "dimension", "$value": "0.75rem" },
        "200": { "$type": "dimension", "$value": "0.875rem" },
        "300": { "$type": "dimension", "$value": "1rem" },
        "400": { "$type": "dimension", "$value": "1.125rem" },
        "500": { "$type": "dimension", "$value": "1.25rem" },
        "600": { "$type": "dimension", "$value": "1.5rem" },
        "700": { "$type": "dimension", "$value": "1.875rem" },
        "800": { "$type": "dimension", "$value": "2.25rem" }
      },
      "lineHeight": {
        "tight": { "$type": "number", "$value": 1.2 },
        "normal": { "$type": "number", "$value": 1.5 },
        "relaxed": { "$type": "number", "$value": 1.7 }
      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": 400 },
        "medium": { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold": { "$type": "fontWeight", "$value": 700 }
      },
      "semantic": {
        "body-sm": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{tokens.typography.fontFamily.sans}",
            "fontSize": "{tokens.typography.size.200}",
            "lineHeight": "{tokens.typography.lineHeight.normal}",
            "fontWeight": "{tokens.typography.weight.regular}"
          }
        },
        "body-md": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{tokens.typography.fontFamily.sans}",
            "fontSize": "{tokens.typography.size.300}",
            "lineHeight": "{tokens.typography.lineHeight.normal}",
            "fontWeight": "{tokens.typography.weight.regular}"
          }
        },
        "heading-lg": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{tokens.typography.fontFamily.sans}",
            "fontSize": "{tokens.typography.size.700}",
            "lineHeight": "{tokens.typography.lineHeight.tight}",
            "fontWeight": "{tokens.typography.weight.bold}"
          }
        }
      }
    },
    "space": {
      "base": { "$type": "dimension", "$value": "0.25rem" },
      "fibonacci": {
        "001": { "$type": "dimension", "$value": "calc({tokens.space.base} * 1)" },
        "002": { "$type": "dimension", "$value": "calc({tokens.space.base} * 2)" },
        "003": { "$type": "dimension", "$value": "calc({tokens.space.base} * 3)" },
        "005": { "$type": "dimension", "$value": "calc({tokens.space.base} * 5)" },
        "008": { "$type": "dimension", "$value": "calc({tokens.space.base} * 8)" },
        "013": { "$type": "dimension", "$value": "calc({tokens.space.base} * 13)" },
        "021": { "$type": "dimension", "$value": "calc({tokens.space.base} * 21)" }
      },
      "semantic": {
        "stack-xs": { "$type": "dimension", "$value": "{tokens.space.fibonacci.002}" },
        "stack-sm": { "$type": "dimension", "$value": "{tokens.space.fibonacci.003}" },
        "stack-md": { "$type": "dimension", "$value": "{tokens.space.fibonacci.005}" },
        "stack-lg": { "$type": "dimension", "$value": "{tokens.space.fibonacci.008}" },
        "inset-sm": { "$type": "dimension", "$value": "{tokens.space.fibonacci.003}" },
        "inset-md": { "$type": "dimension", "$value": "{tokens.space.fibonacci.005}" },
        "inset-lg": { "$type": "dimension", "$value": "{tokens.space.fibonacci.008}" }
      }
    }
  }
}
