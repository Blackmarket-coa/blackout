{
  "name": "@blackout/ui",
  "version": "0.0.1",
  "private": true,
  "description": "React component library (RN-compatible) for Blackout UI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@blackout/config": "workspace:*",
    "@blackout/core": "workspace:*",
    "@blackout/design": "workspace:*",
    "@vanilla-extract/css": "1.20.1",
    "lucide-react-native": "^0.542.0",
    "react": "^19.1.1",
    "react-native": "^0.82.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "typescript": "5.9.3"
  }
}
