DATABASE_URL=postgresql://user:pass@localhost/blackout
REDIS_URL=redis://localhost:6379

# CORS — required in production. Comma-separated list of origin URLs (no trailing slash).
# Use "*" only outside production. CORS_ALLOW_CREDENTIALS=true is incompatible with "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=Authorization,Content-Type
# CORS_EXPOSE_HEADERS=
# CORS_MAX_AGE=600

# Rate limiting
# AUTH_RATE_LIMIT_MAX=10

MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_BOT_TOKEN=syt_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# JWT — use a 32+ char secret with mixed character classes (no "changeme"/"secret"/"password" substrings).
# JWT_SECRET_PRIMARY is preferred; JWT_SECRET is the legacy fallback (do not set both in new deploys).
JWT_SECRET_PRIMARY=your-high-entropy-secret-32-chars-min
# JWT_SECRET_ROLLOVER=comma,separated,verification-only-secrets
# JWT_ISSUER=blackout-api
# JWT_AUDIENCE=blackout-clients

RESEND_API_KEY=re_...
NODE_ENV=development
LOG_LEVEL=info
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_TOKEN_TTL_SECONDS=300
