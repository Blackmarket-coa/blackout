DATABASE_URL=postgresql://user:pass@localhost/blackout
REDIS_URL=redis://localhost:6379

# Persistence for the JSON-backed store (users, invitations, channels,
# messages, etc). `file` (default) writes to BLACKOUT_DB_FILE on every
# mutation; `memory` keeps state in-process and is wiped on restart —
# only use for tests. The Postgres-backed runtime is selected via the
# blackout-api-pg image and is independent of these vars.
# BLACKOUT_DB_MODE=file
#
# Path to the JSON store file. The default resolves relative to the
# process cwd (`./.blackout/data/store.json`), which is fine for local
# dev but ephemeral inside a container — every `docker compose up -d`
# recreate wipes the file. In production set this to a path inside a
# mounted volume, e.g. `/data/blackout/store.json` with a named volume
# on `/data/blackout`. Otherwise invitations, accounts, and everything
# else in the store disappear on container recreate.
# BLACKOUT_DB_FILE=/data/blackout/store.json

# Coalition kit manifests (/v1/coalition-kit-manifests). Enabled by default in
# production; set to `false` as a rollback toggle to take the endpoints offline
# (they then return 404 feature_disabled). Any other value (or unset) = enabled.
# BLACKOUT_COALITION_KIT_MANIFESTS=false

# Public-facing base URL used in shareable invite links and email
# verification links. Must be set in production or links fall back to
# http://localhost:8080. Example: https://chat.theblackout.app
PUBLIC_APP_URL=http://localhost:8080

# CORS — required in production. Comma-separated list of origin URLs (no trailing slash).
# Use "*" only outside production. CORS_ALLOW_CREDENTIALS=true is incompatible with "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=Authorization,Content-Type
# CORS_EXPOSE_HEADERS=
# CORS_MAX_AGE=600

# Rate limiting
# AUTH_RATE_LIMIT_MAX=10

# Bug-report intake (POST /bug-report)
# Rageshake-compatible receiver. Forwarded server-side so GitHub creds
# never leave the API. Leave blank to skip the rageshake leg.
# RAGESHAKE_ENDPOINT_URL=https://matrix.theblackout.app/rageshake/api/submit
# Per-IP, sliding 1h window. Default 5.
# BUG_REPORT_RATE_LIMIT_MAX=5
# GitHub destination — pre-filled to the canonical repo.
# GITHUB_BUG_REPORT_OWNER=Blackmarket-coa
# GITHUB_BUG_REPORT_REPO=blackout
# GITHUB_BUG_REPORT_LABELS=bug,user-reported
# GitHub App auth (prod). Install on the target repo with issues:write.
# Paste PEM with literal \n escapes — the loader normalizes them.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=
# PAT fallback (dev / CI). Only consulted when GITHUB_APP_* are unset.
# GITHUB_BUG_REPORT_PAT=

# Matrix homeserver + bot credentials. REQUIRED for the invite flow: minting
# registration tokens, force-joining the bot, and admitting redeemers all hit
# Synapse admin APIs, so MATRIX_BOT_TOKEN must belong to a user with Synapse
# ADMIN rights. The API probes this at startup and reports it under `matrix`
# in GET /health (adminOk:false means invites will fail at redeem time).
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_BOT_TOKEN=syt_...
# Domain used to build MXIDs / room aliases (defaults to blackout.local).
# MATRIX_HOMESERVER_DOMAIN=example.com

# Migration Hub (Discord). Server import reads the guild list with the user's
# OAuth token (needs the `guilds` scope via DISCORD_OAUTH_SCOPES); reading
# channels/roles requires a bot token in the guild. Without it, imports run in
# degraded preview mode.
# MIGRATION_DISCORD_BOT_TOKEN=Bot-token-for-channel-and-role-reads
# Bridge activation talks to the mautrix-discord appservice provisioning API
# (see deploy/.../mautrix-discord/RUNBOOK.md). Unset = activation reports
# bridge_unavailable instead of silently no-oping.
# MAUTRIX_DISCORD_PROVISIONING_URL=http://mautrix-discord:29334
# MAUTRIX_DISCORD_PROVISIONING_SHARED_SECRET=shared-secret-from-the-runbook
# MAUTRIX_DISCORD_PROVISIONING_PATH=/_matrix/provision/v1/bridge

# Internal image-perturbation sidecar (anti–facial-recognition) used by
# POST /v1/media/perturb. When unset the web client falls back to its
# best-effort client-side perturbation. See services/perturbation/README.md.
# PERTURBATION_SERVICE_URL=http://perturbation:8000

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# Marketplace — Free Black Market (FBM). FBM is the only real marketplace
# provider; the others (Blamazon, MayhemMarketplaze, AntinAmazon) are
# disabled placeholders that return empty catalogs. The marketplace will
# show NOTHING until FBM is configured one of two ways:
#   1. Real catalog: set FREEBLACKMARKET_API_KEY (and the webhook secret).
#      Without the API key, /v1/marketplace/listings returns an empty list.
#   2. Demo data: set FREEBLACKMARKET_STUB=1 to serve ~24 seeded in-memory
#      listings with no upstream API. Dev/demo only — never in production.
# In production the API refuses to start while FBM is enabled but missing its
# secrets; set FREEBLACKMARKET_ENABLED=false to opt out entirely instead.
# FREEBLACKMARKET_ENABLED=true
# FREEBLACKMARKET_API_KEY=fbm_live_...
# FREEBLACKMARKET_WEBHOOK_SECRET=whsec_...
# FREEBLACKMARKET_BASE_URL=https://api.freeblackmarket.com
# FREEBLACKMARKET_STUB=1

# JWT — use a 32+ char secret with mixed character classes (no "changeme"/"secret"/"password" substrings).
# JWT_SECRET_PRIMARY is preferred; JWT_SECRET is the legacy fallback (do not set both in new deploys).
JWT_SECRET_PRIMARY=your-high-entropy-secret-32-chars-min
# JWT_SECRET_ROLLOVER=comma,separated,verification-only-secrets
# JWT_ISSUER=blackout-api
# JWT_AUDIENCE=blackout-clients

# Mailer transport selection. Production must set one of `resend` / `smtp`;
# `console` is staging-only and rejected if NODE_ENV=production unless
# explicitly set. See packages/api/src/services/mailer.ts.
# MAIL_PROVIDER=resend
# MAIL_FROM_ADDRESS=Blackout <noreply@your-domain.example>

# Resend transport (MAIL_PROVIDER=resend)
RESEND_API_KEY=re_...
# MAIL_RESEND_API_KEY=re_...

# SMTP transport (MAIL_PROVIDER=smtp) — failover path when Resend has a
# regional outage, or for self-hosters who prefer their own MTA.
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587            # 465 for implicit TLS; STARTTLS otherwise
# MAIL_SMTP_SECURE=false        # set true (or omit if PORT=465) for implicit TLS
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=

# Auto-failover (MAIL_PROVIDER=resend-failover-smtp) — wraps both transports
# in a circuit breaker. Resend is primary; after N consecutive failures the
# breaker opens and routes through SMTP for a cooldown window before
# probing Resend again. Both Resend and SMTP env vars above must be set.
# MAIL_FAILOVER_FAILURE_THRESHOLD=3
# MAIL_FAILOVER_COOLDOWN_MS=300000   # 5 minutes

# Observability — all optional. The /metrics endpoint is gated by this token
# in production; configure your scraper to send it as Authorization: Bearer.
INTERNAL_METRICS_TOKEN=
# SENTRY_DSN=https://example@sentry.io/123
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=blackout-api

NODE_ENV=development
LOG_LEVEL=info
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_TOKEN_TTL_SECONDS=300

# Giphy GIF picker proxy (/v1/integrations/giphy) — the preferred provider.
# Get a key at https://developers.giphy.com/dashboard/.
# When unset, the client falls back to Tenor (below); when both are unset,
# the composer GIF tab falls back to user-uploaded GIF packs.
# GIPHY_API_KEY=
# GIPHY_RATE_LIMIT_MAX=30           # per-IP, 1-minute sliding window
# GIPHY_RATING=pg-13                # g | pg | pg-13 | r
# GIPHY_LANG=en                     # optional, ISO-639-1

# Tenor GIF picker proxy (/v1/integrations/tenor) — fallback provider.
# Get a free key at https://tenor.com/developer/keyregistration.
# When unset (and Giphy too), the composer GIF tab falls back to
# user-uploaded GIF packs.
# TENOR_API_KEY=
# TENOR_RATE_LIMIT_MAX=30           # per-IP, 1-minute sliding window
# TENOR_CONTENT_FILTER=medium       # off | low | medium | high
# TENOR_LOCALE=en_US                # optional, ISO-639-1 with region
