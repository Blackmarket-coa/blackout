{
    "name": "@blackout/api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "Blackout Hono API scaffold",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "worker": "tsx src/worker.ts",
        "build": "node -e \"console.log('api build scaffold ok')\"",
        "lint": "node -e \"console.log('api lint scaffold ok')\"",
        "test": "tsx --test --test-force-exit --test-concurrency=1 test/**/*.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test:integration": "tsx --test test/**/*.integration.test.ts",
        "test:launch-smoke": "tsx --test test/launch-smoke.integration.test.ts",
        "provision:rooms": "tsx src/scripts/provisionContributorRooms.ts",
        "migrate": "tsx src/db/migrate.ts up",
        "migrate:up": "tsx src/db/migrate.ts up",
        "migrate:down": "tsx src/db/migrate.ts down",
        "migrate:status": "tsx src/db/migrate.ts status",
        "db:import-json": "tsx src/scripts/importJsonStoreToPostgres.ts",
        "db:verify-import": "tsx src/scripts/verifyJsonStoreImport.ts"
    },
    "dependencies": {
        "@blackout/contracts": "workspace:*",
        "@blackout/core": "workspace:*",
        "@blackout/protocol": "workspace:*",
        "@hono/node-server": "2.0.10",
        "@simplewebauthn/server": "13.3.3",
        "hono": "4.12.34",
        "ioredis": "5.10.1",
        "jose": "5.10.0",
        "livekit-server-sdk": "^2.15.2",
        "nodemailer": "^9.0.1",
        "pg": "^8.13.1",
        "socket.io": "^4.8.3",
        "ws": "^8.18.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^22.19.15",
        "@types/nodemailer": "^7.0.4",
        "@types/pg": "^8.11.10",
        "socket.io-client": "^4.8.3",
        "typescript": "5.9.3"
    }
}
