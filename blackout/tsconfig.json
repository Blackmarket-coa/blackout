{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "paths": {
      "@blackout/core": ["./packages/core/src"],
      "@blackout/config": ["./packages/config"],
      "@blackout/ui": ["./packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".expo"]
}
