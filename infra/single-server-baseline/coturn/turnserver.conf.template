listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=${TURN_STATIC_AUTH_SECRET}
realm=turn.theblackout.app
server-name=turn.theblackout.app
external-ip=${TURN_EXTERNAL_IP}
listening-ip=0.0.0.0

no-cli
no-multicast-peers
no-loopback-peers
stale-nonce=600
no-software-attribute
no-tlsv1
no-tlsv1_1

cert=/etc/letsencrypt/live/theblackout.app/fullchain.pem
pkey=/etc/letsencrypt/live/theblackout.app/privkey.pem
cipher-list=ECDHE+AESGCM:ECDHE+CHACHA20:!aNULL:!MD5:!DSS
dh-file=/etc/coturn/dhparam.pem

# Relay range pinned for firewalling.
min-port=49160
max-port=49200
total-quota=120
bps-capacity=0

# Prevent accidental public STUN/TURN abuse by requiring authenticated relay only.
no-stun-backward-compatibility
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Optional monitoring endpoint used by reverse proxy /healthz.
prometheus
prometheus-port=9641
