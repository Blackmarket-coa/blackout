# Image tags
FRONTEND_TAG=stable
API_TAG=stable

# Database
POSTGRES_DB=blackout
POSTGRES_USER=blackout
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Synapse secrets
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGE_ME_64_CHAR_SECRET
SYNAPSE_MACAROON_SECRET_KEY=CHANGE_ME_64_CHAR_SECRET
SYNAPSE_FORM_SECRET=CHANGE_ME_64_CHAR_SECRET

# Self-signup posture. Defaults allow open registration without 3PID/captcha
# verification so the homeserver is usable on first boot. Set both to false
# once an email or reCAPTCHA verifier is configured in homeserver.yaml.
SYNAPSE_ENABLE_REGISTRATION=true
SYNAPSE_ENABLE_REGISTRATION_WITHOUT_VERIFICATION=true
# Gate registration behind one-time tokens issued by an admin. Pairs with
# SYNAPSE_ENABLE_REGISTRATION=true to give an invite-only homeserver
# without a separate matrix-registration sidecar. Runbook:
# infra/single-server-baseline/synapse/ENABLE_REGISTRATION.md
SYNAPSE_REGISTRATION_REQUIRES_TOKEN=true

# TURN
TURN_STATIC_AUTH_SECRET=CHANGE_ME_64_CHAR_SECRET
TURN_EXTERNAL_IP=203.0.113.10

# Domain and contact
PRIMARY_DOMAIN=theblackout.app
LETSENCRYPT_EMAIL=ops@theblackout.app

# Analytics warehouse — see docs/runbooks/ANALYTICS_WAREHOUSE.md
# Shared by the clickhouse service and the api service's telemetry ingest
# (POST /v1/telemetry/events → analytics_raw.events).
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_CLICKHOUSE_PASSWORD
# Cube API secret — used to sign Cube's playground tokens.
# Generate with: openssl rand -hex 32
CUBE_API_SECRET=CHANGE_ME_64_CHAR_SECRET

# Blackout API (Hono) — required for the api service in docker-compose.yml.
# JWT_SECRET_PRIMARY signs auth tokens (generate with: openssl rand -hex 32).
# BLACKOUT_DB_PASSWORD is consumed by the optional database-isolation override.
BLACKOUT_DB_PASSWORD=CHANGE_ME_STRONG_API_DB_PASSWORD
JWT_SECRET_PRIMARY=CHANGE_ME_64_CHAR_SECRET

# Bearer token the API uses to authenticate against Synapse's admin API
# (user registration, registration-token minting, room invites). Mint via
# the Synapse admin user, store it once, and rotate on incident.
MATRIX_BOT_TOKEN=CHANGE_ME_SYNAPSE_ADMIN_ACCESS_TOKEN

# Image-perturbation sidecar URL. The compose stack ships a `perturbation`
# service; the API defaults to http://perturbation:8000. Unset to disable the
# sidecar and let clients fall back to client-side perturbation.
# PERTURBATION_SERVICE_URL=http://perturbation:8000

# Bearer token required to scrape the API's /metrics endpoint. The API
# returns 503 when this is unset in production. Generate with:
# openssl rand -hex 32
INTERNAL_METRICS_TOKEN=CHANGE_ME_64_CHAR_SECRET
