# Image tags. All three images are built locally by deploy.sh (no registry
# pull): blackout-frontend:stable, blackout-api:hono, blackout-synapse:stable.
# See RUNBOOK §1 "Images".
FRONTEND_TAG=stable
API_TAG=hono
SYNAPSE_TAG=stable

# Database
POSTGRES_DB=blackout
POSTGRES_USER=blackout
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Synapse secrets
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGE_ME_64_CHAR_SECRET
SYNAPSE_MACAROON_SECRET_KEY=CHANGE_ME_64_CHAR_SECRET
SYNAPSE_FORM_SECRET=CHANGE_ME_64_CHAR_SECRET

# Self-signup posture. Defaults allow open registration without 3PID/captcha
# verification so the homeserver is usable on first boot. Set both to false
# once an email or reCAPTCHA verifier is configured in homeserver.yaml.
SYNAPSE_ENABLE_REGISTRATION=true
SYNAPSE_ENABLE_REGISTRATION_WITHOUT_VERIFICATION=true
# Gate registration behind one-time tokens issued by an admin. Pairs with
# SYNAPSE_ENABLE_REGISTRATION=true to give an invite-only homeserver
# without a separate matrix-registration sidecar. Runbook:
# infra/single-server-baseline/synapse/ENABLE_REGISTRATION.md
SYNAPSE_REGISTRATION_REQUIRES_TOKEN=true

# TURN
TURN_STATIC_AUTH_SECRET=CHANGE_ME_64_CHAR_SECRET
TURN_EXTERNAL_IP=203.0.113.10

# Domain and contact
PRIMARY_DOMAIN=theblackout.app
LETSENCRYPT_EMAIL=ops@theblackout.app

# Analytics warehouse — see docs/runbooks/ANALYTICS_WAREHOUSE.md
# Shared by the clickhouse service and the api service's telemetry ingest
# (POST /v1/telemetry/events → analytics_raw.events).
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_CLICKHOUSE_PASSWORD
# Cube API secret — used to sign Cube's playground tokens.
# Generate with: openssl rand -hex 32
CUBE_API_SECRET=CHANGE_ME_64_CHAR_SECRET

# Blackout API (Hono) — required for the api service in docker-compose.yml.
# JWT_SECRET_PRIMARY signs auth tokens (generate with: openssl rand -hex 32).
# BLACKOUT_DB_PASSWORD is consumed by the optional database-isolation override.
BLACKOUT_DB_PASSWORD=CHANGE_ME_STRONG_API_DB_PASSWORD
JWT_SECRET_PRIMARY=CHANGE_ME_64_CHAR_SECRET
# LOG_HASH_SALT pseudonymizes identifiers in API logs. Required: the API refuses
# to start in production without it. Use a high-entropy value (openssl rand -hex 32)
# and keep it stable; rotating it breaks joins across log archives
# (docs/security/metadata-minimization.md).
LOG_HASH_SALT=CHANGE_ME_64_CHAR_SECRET

# Bearer token the API uses to authenticate against Synapse's admin API
# (user registration, registration-token minting, room invites). Mint via
# the Synapse admin user, store it once, and rotate on incident.
MATRIX_BOT_TOKEN=CHANGE_ME_SYNAPSE_ADMIN_ACCESS_TOKEN

# Free Black Market marketplace link (RUNBOOK §19) — consumed by the
# FREEBLACKMARKET_* block in docker-compose.override.yml. The API key must
# match the FBM backend's FREEBLACKMARKET_API_KEY; the webhook secret must
# match its FREEBLACKMARKET_WEBHOOK_SECRET.
FREEBLACKMARKET_API_KEY=CHANGE_ME_FBM_COMMERCE_API_KEY
FREEBLACKMARKET_WEBHOOK_SECRET=CHANGE_ME_FBM_WEBHOOK_SECRET
# FBM service-token integration + FBM-driven workers (RUNBOOK §19) — all
# default off. Consumed by the commented FBM_* entries in
# docker-compose.override.yml. The base URL is the FBM origin over bmc-bridge
# (origin + /v1/integrations/blackout is also accepted); the token must equal
# the FBM backend's ENTITLEMENTS_SERVICE_TOKEN.
# FBM_ENTITLEMENTS_BASE_URL=http://free-black-market-backend-1:9000
# FBM_ENTITLEMENTS_SERVICE_TOKEN=CHANGE_ME_FBM_ENTITLEMENTS_SERVICE_TOKEN
# FBM_MATRIX_BRIDGE_ENABLED=0
# FBM_ACL_SYNC_ENABLED=0

# Image-perturbation sidecar URL. The compose stack ships a `perturbation`
# service; the API defaults to http://perturbation:8000. Unset to disable the
# sidecar and let clients fall back to client-side perturbation.
# PERTURBATION_SERVICE_URL=http://perturbation:8000

# Bearer token required to scrape the API's /metrics endpoint. The API
# returns 503 when this is unset in production. Generate with:
# openssl rand -hex 32
INTERNAL_METRICS_TOKEN=CHANGE_ME_64_CHAR_SECRET

# MatrixRTC / LiveKit (voice & video calls) — consumed by the livekit and
# lk-jwt services, and rendered into livekit/livekit.yaml from
# livekit/livekit.yaml.template. Generate a key pair with:
#   docker run --rm livekit/livekit-server:v1.8.4 generate-keys
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_API_SECRET
# Public websocket URL clients receive in minted call tokens — the nginx
# path on the matrix vhost, not the container address.
LIVEKIT_PUBLIC_WS_URL=wss://matrix.theblackout.app/livekit/sfu

# Draupnir moderation sidecar — rendered into draupnir/production.yaml.
# Bootstrap (RUNBOOK "Draupnir moderation sidecar"): register a dedicated
# bot account, mint it a non-expiring access token, create a private
# management room, and invite the bot + your moderators.
DRAUPNIR_ACCESS_TOKEN=CHANGE_ME_DRAUPNIR_BOT_ACCESS_TOKEN
DRAUPNIR_MANAGEMENT_ROOM=#draupnir-management:theblackout.app

# Coalition demo seed data is OFF in production (NODE_ENV=production). Set to 1
# only for a demo host. Rows seeded by older builds are removed with
# `pnpm --filter @blackout/api db:clean-demo-seed --apply` (API stopped).
# BLACKOUT_SEED_DEMO_DATA=0
