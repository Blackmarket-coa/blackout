server_name: "theblackout.app"
pid_file: /data/homeserver.pid
public_baseurl: "https://matrix.theblackout.app/"
listeners:
  - port: 8008
    type: http
    tls: false
    x_forwarded: true
    resources:
      - names: [client, federation, media, keys, consent]
        compress: false

database:
  name: psycopg2
  args:
    user: ${POSTGRES_USER}
    password: ${POSTGRES_PASSWORD}
    database: ${POSTGRES_DB}
    host: postgres
    cp_min: 5
    cp_max: 15

redis:
  enabled: true
  host: redis
  port: 6379
  password: ${REDIS_PASSWORD}

media_store_path: /media
max_upload_size: 100M
max_image_pixels: "50M"
dynamic_thumbnails: true

# Launch posture: open self-signup by default (can be overridden via env).
# Synapse rejects registration with M_FORBIDDEN ("Registration has been
# disabled") whenever enable_registration is true but no verification path
# (email/captcha/3PID) is configured AND
# enable_registration_without_verification is false. We default to true so
# self-signup works out of the box; flip the env to false once an email/SMS
# or reCAPTCHA verifier is wired up.
enable_registration: ${SYNAPSE_ENABLE_REGISTRATION:-true}
enable_registration_without_verification: ${SYNAPSE_ENABLE_REGISTRATION_WITHOUT_VERIFICATION:-true}
registration_shared_secret: "${SYNAPSE_REGISTRATION_SHARED_SECRET}"
macaroon_secret_key: "${SYNAPSE_MACAROON_SECRET_KEY}"
form_secret: "${SYNAPSE_FORM_SECRET}"
signing_key_path: /data/theblackout.app.signing.key
trusted_key_servers:
  - server_name: "matrix.org"

# Delegated auth (OIDC): configure one issuer (Keycloak or Authentik) via env.
# Example issuers:
# - Keycloak: https://keycloak.theblackout.app/realms/blackout
# - Authentik: https://auth.theblackout.app/application/o/blackout/
oidc_providers:
  - idp_id: "${SYNAPSE_OIDC_IDP_ID:-blackout-oidc}"
    idp_name: "${SYNAPSE_OIDC_IDP_NAME:-Blackout SSO}"
    issuer: "${SYNAPSE_OIDC_ISSUER}"
    client_id: "${SYNAPSE_OIDC_CLIENT_ID}"
    client_secret: "${SYNAPSE_OIDC_CLIENT_SECRET}"
    scopes: ["openid", "profile", "email"]
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username or user.sub }}"
        display_name_template: "{{ user.name or user.preferred_username }}"
        email_template: "{{ user.email }}"
    backchannel_logout_enabled: true

# TURN (coturn static-auth-secret)
# Keep this in lock-step with coturn:
# - turn_shared_secret must match TURN_STATIC_AUTH_SECRET used by coturn static-auth-secret
# - turn_uris host/ports must match coturn listeners and exposed firewall rules
turn_uris:
  - "turn:turn.theblackout.app:3478?transport=udp"
  - "turn:turn.theblackout.app:3478?transport=tcp"
  - "turns:turn.theblackout.app:5349?transport=tcp"
turn_shared_secret: "${TURN_STATIC_AUTH_SECRET}"
turn_user_lifetime: 1h
turn_allow_guests: false

# Abuse resistance defaults tuned for launch day.
rc_message:
  per_second: 0.2
  burst_count: 10
rc_registration:
  per_second: 0.003
  burst_count: 5
rc_login:
  address:
    per_second: 0.003
    burst_count: 5
  account:
    per_second: 0.003
    burst_count: 5
  failed_attempts:
    per_second: 0.1
    burst_count: 5
rc_joins:
  local:
    per_second: 0.1
    burst_count: 10
  remote:
    per_second: 0.01
    burst_count: 10

# Keep this mounted at /data for simple backups.
log_config: "/data/theblackout.app.log.config"
